# Copy to ".env.local" and adjust. ".env.local" is git-ignored. Examples only.

# Public URL of this website (used for sitemap and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the Spring Boot backend (GROUP 3), without trailing slash
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# URL of the Student Project Platform (GROUP 2)
NEXT_PUBLIC_STUDENT_PLATFORM_URL=http://localhost:3001

# Company contact details shown on the site (replace the examples with real values)
NEXT_PUBLIC_CONTACT_EMAIL=abelkomiga1815@gmail.com
NEXT_PUBLIC_CONTACT_PHONE=+255741802729
NEXT_PUBLIC_CONTACT_ADDRESS=

# Email notification settings (for service request form submissions)
# These are used by the frontend email sending utility; never commit actual credentials
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
