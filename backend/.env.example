# Copy this file to ".env" and adjust the values. ".env" is git-ignored.
# These are EXAMPLES only - never commit real credentials.
# Do not wrap values in quotes (the file is read in Java properties format).

# --- Database (required) ---
DATABASE_URL=jdbc:postgresql://localhost:5433/abittech
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_password_here

# --- JWT (required) ---
# At least 32 characters. Generate one, for example:
#   Linux/macOS:  openssl rand -base64 48
#   PowerShell:   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_characters
# Token lifetime in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION=86400000

# --- CORS (optional) ---
# Comma-separated frontend origins allowed to call the API from a browser.
# Leave empty to disallow cross-origin access.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- AI research engine (required) ---
# Base URL of the Python service and the shared secret (>= 32 characters, same value on both sides).
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=replace_with_the_same_long_secret_used_by_the_ai_service

# --- Rate limits for public endpoints (optional) ---
# RATE_LIMIT_AUTH_PER_MINUTE=10
# RATE_LIMIT_INQUIRY_PER_MINUTE=5
# Only behind a trusted reverse proxy that sets X-Forwarded-For: FORWARD_HEADERS_STRATEGY=framework

# --- Document storage (optional) ---
# Where uploaded project documents are kept. Back this directory up; it holds user files.
# DOCUMENTS_DIR=./data/documents

# --- Optional ---
# SERVER_PORT=8080
# SPRING_PROFILES_ACTIVE=dev
