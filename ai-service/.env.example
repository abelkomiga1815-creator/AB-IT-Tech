# Copy to ".env" and adjust. ".env" is git-ignored. Examples only - never commit real secrets.

# Shared secret between the Spring Boot backend and this service (sent as the X-API-Key header).
# REQUIRED, at least 32 characters. Generate one, for example:  openssl rand -base64 48
AI_SERVICE_API_KEY=

# Contact e-mail sent to OpenAlex and Crossref so they can reach you (their "polite pool"). Recommended.
CONTACT_EMAIL=

# Optional Semantic Scholar API key (higher rate limits). Leave empty to use the public limits.
SEMANTIC_SCHOLAR_API_KEY=

# Optional tuning
# PROVIDER_TIMEOUT_SECONDS=10
# CACHE_TTL_SECONDS=3600
# CACHE_MAX_ENTRIES=500
# AI_SERVICE_LOG_LEVEL=INFO
# Serve the interactive API docs at /docs (development only; off by default)
# AI_SERVICE_ENABLE_DOCS=true
