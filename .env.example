# Copy to ".env" next to docker-compose.yml. ".env" is git-ignored. These are EXAMPLES only:
# replace every value that says "replace_" and never commit real secrets.

# --- Database ---
DATABASE_USERNAME=abittech
DATABASE_PASSWORD=replace_with_a_strong_database_password

# --- Backend ---
# At least 32 characters each. Generate:  openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_characters
# Shared secret between the backend and the AI research engine (same value used on both sides)
AI_SERVICE_API_KEY=replace_with_another_long_random_secret_of_at_least_32_chars
JWT_EXPIRATION=86400000

# --- Public addresses (as browsers see them) ---
# Local defaults. For a real deployment use your HTTPS domains, e.g. https://abittech.example
PUBLIC_API_URL=http://localhost:8080
PUBLIC_WEBSITE_URL=http://localhost:3000
PUBLIC_STUDENT_URL=http://localhost:3001
# Origins allowed to call the backend from a browser (the corporate website sends inquiries from the browser)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Company contact details (optional) ---
# Shown on the website. CONTACT_EMAIL is also sent to OpenAlex/Crossref by the AI engine so they can reach
# you ("polite pool": more reliable access), so a real address is recommended.
CONTACT_EMAIL=abelkomiga1815@gmail.com
CONTACT_PHONE=255741802729
CONTACT_ADDRESS=

# --- AI research engine (optional) ---
# Semantic Scholar API key for higher rate limits; leave empty to use the public limits
SEMANTIC_SCHOLAR_API_KEY=
